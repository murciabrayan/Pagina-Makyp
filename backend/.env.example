# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube al repositorio.

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------- base de datos
# En local, los datos sueltos:
POSTGRES_DB=makyp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# En producción basta con esta, que da la plataforma, y se ignoran las de arriba:
# DATABASE_URL=postgres://usuario:clave@servidor:5432/basedatos

# ------------------------------------------------ fotos que sube el equipo
# Vacío en local: se guardan en backend/media/.
# En producción, las credenciales de Cloudflare R2:
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_DOMINIO_PUBLICO=

# Dirección pública del sitio, para las fotos que viven en el frontend.
FRONTEND_ASSET_BASE_URL=
